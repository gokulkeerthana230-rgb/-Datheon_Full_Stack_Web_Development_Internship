# ==============================================================================
# OpenWeatherMap API Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to '.env' (or 'api/.ENV'):
#    In Bash / macOS / Linux:  cp .env.example .env
#    In PowerShell (Windows):  Copy-Item .env.example .env
#
# 2. Obtain your free OpenWeatherMap API key:
#    - Sign up at: https://home.openweathermap.org/users/sign_up
#    - Verify your email address
#    - Navigate to: https://home.openweathermap.org/api_keys
#
# 3. Replace 'your_openweathermap_api_key_here' with your 32-character key.
#
# 4. SECURITY NOTICE:
#    - NEVER commit '.env' or your actual secret API key to GitHub!
#    - Keep this '.env.example' file tracked with placeholder values only.
# ==============================================================================

# Standard OpenWeatherMap environment variable
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Vite-compatible environment variable prefix (if running with Vite)
VITE_OPENWEATHER_API_KEY=your_openweathermap_api_key_here

